# ============================================
# GHOST — Environment Configuration
# Copy this file to ".env" and fill in your values.
# Never commit your real .env file.
# ============================================

# --- Discord Bot (required) ---
# From https://discord.com/developers/applications -> Your App -> Bot -> Token
DISCORD_TOKEN=

# From https://discord.com/developers/applications -> Your App -> General Information -> Application ID
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- AI Provider ---
# Which provider Ghost's brain uses right now: "gemini" or "openai"
AI_PROVIDER=gemini

# Google AI Studio key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI key (billing required): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# Local SQLite file, zero setup, zero cost. Swap for a Postgres URL later if you outgrow it.
DATABASE_URL="file:./dev.db"

# --- Wake word ---
# The word/phrase that activates Ghost when a message starts with it (case-insensitive)
GHOST_WAKE_WORD=ghost

# --- CEO authorization (optional) ---
# This user must also have the Discord Administrator permission in the server.
GHOST_CEO_USER_ID=

# --- Control Center ---
# Discord account allowed to log into the owner dashboard.
OWNER_USER_ID=
# Public URL used by Discord OAuth2, e.g. https://control.example.com
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
SESSION_SECRET=

# --- Debugging (optional) ---
# Set to "true" to print extra debug-level log lines. Leave blank/unset for normal use.
GHOST_DEBUG=
